{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/session_start_context.py\"",
            "timeout": 30,
            "statusMessage": "Loading Codex workflow context"
          }
        ]
      }
    ]
  }
}
