{
  "info": {
    "name": "Haejillyeok BE",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "auth",
      "item": [
        {
          "name": "로그인",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{accountId}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "계정 ID/비밀번호로 기존 계정을 인증하고 세션 쿠키를 발급합니다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const setCookie = pm.response.headers.get(\"Set-Cookie\");",
                  "if (setCookie) {",
                  "  const match = setCookie.match(/session_token=([^;]+)/);",
                  "  if (match) {",
                  "    const sessionToken = decodeURIComponent(match[1]);",
                  "    pm.environment.set(\"sessionToken\", sessionToken);",
                  "    console.log(\"sessionToken environment variable updated.\");",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "회원가입",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{accountId}}\",\n  \"nickname\": \"{{nickname}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "계정 ID/닉네임/비밀번호로 신규 계정을 만들고 세션 쿠키를 발급합니다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const setCookie = pm.response.headers.get(\"Set-Cookie\");",
                  "if (setCookie) {",
                  "  const match = setCookie.match(/session_token=([^;]+)/);",
                  "  if (match) {",
                  "    const sessionToken = decodeURIComponent(match[1]);",
                  "    pm.environment.set(\"sessionToken\", sessionToken);",
                  "    console.log(\"sessionToken environment variable updated.\");",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
