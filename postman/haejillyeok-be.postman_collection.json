    {
      "name": "game",
      "item": [
        {
          "name": "로비 객실 목록 조회",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "session_token={{sessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/game/rooms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "game",
                "rooms"
              ]
            },
            "description": "로그인 유저가 로비에서 선택할 수 있는 객실 목록을 조회합니다."
          }
        },
        {
          "name": "로비 객실 생성",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "session_token={{sessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/game/rooms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "game",
                "rooms"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{roomName}}\",\n  \"game_type\": \"{{gameType}}\",\n  \"max_players\": {{maxPlayers}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "로그인 유저를 방장으로 하는 대기 객실을 만들고 방장 멤버십을 함께 등록합니다."
          }
        },
        {
          "name": "로비 객실 참여",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "session_token={{sessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/game/rooms/{{roomPublicId}}/join",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "game",
                "rooms",
                "{{roomPublicId}}",
                "join"
              ]
            },
            "description": "로그인 유저를 대기 중인 객실 멤버로 참여시키고 로비 구독자에게 알립니다."
          }
        },
        {
          "name": "게임 세션 시작",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "session_token={{sessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/game/rooms/{{roomPublicId}}/start",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "game",
                "rooms",
                "{{roomPublicId}}",
                "start"
              ]
            },
            "description": "방장이 활성 room member를 고정하고 게임 세션 진입 식별자를 발급합니다."
          }
        },
        {
          "name": "게임 세션 진입 권한 확인",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "session_token={{sessionToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/game/sessions/{{gameSessionPublicId}}/entry",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "game",
                "sessions",
                "{{gameSessionPublicId}}",
                "entry"
              ]
            },
            "description": "로그인 유저가 게임 시작 시 확정된 참가자인지 확인합니다."
          }
        }
      ]
    }
  ]
