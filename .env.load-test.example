# Copy to .env.load-test or export these values in your shell before running load tests.

# Remote private IP Agent target used by the BE server.
AGENT_URL=http://10.0.0.10:8001
K3S_AGENT_KEY=replace-with-private-agent-key-if-required

# Load-test BE runtime.
BE_ENV=local
APP_TIMEZONE=Asia/Seoul
BE_LOADTEST_WORKERS=1

# Docker PostgreSQL target used by docker-compose.load-test.yml.
BE_DB_HOST=postgres
BE_DB_PORT=5432
BE_DB_USER=haejillyeok
BE_DB_PASSWORD=haejillyeok
BE_DB_NAME=haejillyeok

# Observability.
OTEL_ENABLED=true
OTEL_METRIC_EXPORT_INTERVAL=5000
LOG_FILE_ENABLED=true

# Docker k6 runner image.
K6_IMAGE=grafana/k6:0.49.0
